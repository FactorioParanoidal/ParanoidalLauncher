<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI pictures tool (not shipped): the window and dialogs of the launcher rendered to PNG by Avalonia.Headless with
       Skia, so a test never shows a window on the desktop or takes the focus from a game. Usage at the top of UiShot.cs.
       dotnet build tools/UiShot -c Release; then run bin/Release/net10.0/UiShot. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UiShot</AssemblyName>
    <RootNamespace>Paranoidal</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ParanoidalLauncher.csproj" />
  </ItemGroup>
</Project>
