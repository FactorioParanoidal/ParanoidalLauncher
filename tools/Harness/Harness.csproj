<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test harness for the launcher engine (not shipped): every src/*.cs (the engine; the window is in src/UI)
       plus tools/Harness.cs. dotnet build tools/Harness -c Release; then run bin/Release/net10.0/Harness. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Harness</AssemblyName>
    <RootNamespace>Paranoidal</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- HttpWebRequest (SYSLIB0014) stays until the engine moves to HttpClient -->
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/*.cs" Exclude="../../src/Program.cs;../../src/MainForm.cs;../../src/Ui.cs;../../src/Controls.cs;../../src/StartScreen.cs;../../src/FolderPicker.cs;../../src/Dialogs.cs" />
    <Compile Include="../Harness.cs" />
  </ItemGroup>
</Project>
